#!/usr/bin/env bash
# Compatibility entry point for existing SessionStart registrations.
source_path=${BASH_SOURCE[0]}
while [[ -L $source_path ]]; do
    source_dir=$(cd -P -- "$(dirname -- "$source_path")" && pwd) || exit 0
    source_path=$(readlink "$source_path") || exit 0
    [[ $source_path == /* ]] || source_path="$source_dir/$source_path"
done
exec "$(dirname -- "$source_path")/t-session-start" "$@"
