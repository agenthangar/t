#!/bin/sh
# A live canonical main checkout should be advanced by PR, not committed in place.
here=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
branch=$(git symbolic-ref --short -q HEAD 2>/dev/null) || exit 0
[ "$branch" = main ] || exit 0
common=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
case "$common" in /*) ;; *) common="$here/$common" ;; esac
primary=$(cd "$common/.." 2>/dev/null && pwd -P) || exit 0
here=$(cd "$here" 2>/dev/null && pwd -P) || exit 0
[ "$here" = "$primary" ] || exit 0
[ -d "$primary/.git" ] || exit 0
[ -L "$HOME/bin/t" ] || exit 0
live=$(readlink "$HOME/bin/t")
case "$live" in "$primary/bin/t")
    echo "pre-commit: refusing to commit on main in the live t checkout ($primary)." >&2
    echo "  Work in a session worktree, or override once with git commit --no-verify." >&2
    exit 1
    ;;
esac
exit 0
